import "org.stardustxr.Types" as types

/// Receives raw mouse input
interface MouseHandler {
    /// delta is +Y == Up +X == Right
	motion(delta: types::Vec2f, timestamp: Option<types::Timestamp>)
	/// button code from `input_event_codes.h`
	button(button: u32, pressed: bool, timestamp: Option<types::Timestamp>)
    /// delta is +Y == Up +X == Right
	scroll_smooth(delta: types::Vec2f, source: ScrollSource, timestamp: Option<types::Timestamp>)
    /// delta is +Y == Up +X == Right
	scroll_discrete(delta: types::Vec2f, source: ScrollSource, timestamp: Option<types::Timestamp>)
}

/// The physical source type of a scroll event
enum ScrollSource {
	Wheel,
	Finger,
	Continuous,
	WheelTilt
}
