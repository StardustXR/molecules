import "org.stardustxr.Types" as types
import "org.stardustxr.Keymap" as keymap

/// Receives raw keyboard input
interface KeyboardHandler {
	key(event: KeyEvent, timestamp: Option<types::Timestamp>)
}

/// A event for a key state change
struct KeyEvent {
	/// Linux event code, to get an xkbcommon keycode add 8
    keycode: u32,
    pressed: bool,
	/// Current modifier state
    modifiers: ModifierState,
	/// Current keymap
    keymap: Ref<keymap::Keymap>,
}

/// Modifier state driven by xkbcommon
struct ModifierState {
	depressed: u32,
	latched: u32,
	locked: u32,
}
