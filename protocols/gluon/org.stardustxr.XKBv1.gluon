import "org.stardustxr.Types" as types
import "org.stardustxr.Keymap" as keymap

/// Receives raw keyboard input
interface KeyboardHandler {
	/// Keycode is a linux event code, to get an xkbcommon keycode add 8
	key_state(keycode: u32, pressed: bool, timestamp: Option<types::Timestamp>, modifiers: ModifierState, keymap: Ref<keymap::Keymap>)
}

/// Modifier state driven by xkbcommon
struct ModifierState {
	depressed: u32,
	latched: u32,
	locked: u32,
}
